{
  "name": "lookup",
  "productName": "Lookup",
  "version": "1.0.0",
  "description": "A fast, native-feeling desktop client for Databases / Redis",
  "main": "src/main/main.js",
  "author": "Ali",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js && node test/binds-test.js && node test/export-test.js && node test/alter-test.js && node test/lost-test.js && node test/pg-test.js && node test/mysql-test.js && node --no-warnings test/sqlite-test.js && node test/clickhouse-test.js && node test/redis-test.js && node test/redis-cluster-test.js && node test/mongodb-test.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:zip": "electron-builder --win zip --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "exceljs": "^4.4.0",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.5",
    "oracledb": "^7.0.1",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lookup.app",
    "productName": "Lookup",
    "files": [
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Lookup-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "mac": {
      "identity": "-",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
